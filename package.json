{
  "name": "@geocodio/console-ui",
  "version": "0.1.0",
  "description": "React components and design tokens for dashboards and internal tools, built on Base UI and Tailwind v4.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./base.css": "./styles/base.css",
    "./fonts.css": "./styles/fonts.css",
    "./animations.css": "./styles/animations.css",
    "./overlays.css": "./styles/overlays.css",
    "./strict-palette.css": "./styles/strict-palette.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "version": "node -e \"const f='src/index.ts',fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/PACKAGE_VERSION = '[^']*'/,\\\"PACKAGE_VERSION = '\\\"+require('./package.json').version+\\\"'\\\"))\" && git add src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geocodio/console-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Geocodio/console-ui#readme",
  "bugs": {
    "url": "https://github.com/Geocodio/console-ui/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "base-ui",
    "tailwind",
    "dashboard",
    "internal-tools"
  ]
}
